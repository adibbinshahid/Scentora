datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String?
  role          String         @default("CUSTOMER") // CUSTOMER | ADMIN | SUPER_ADMIN
  emailVerified DateTime?
  createdAt     DateTime       @default(now())
  orders        Order[]
  wishlist      WishlistItem[]
  reviews       Review[]
  addresses     Address[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street     String
  city       String
  state      String
  zipCode    String
  country    String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String
  story         String?
  concentration String         // EDP | EDT | EDP Intense
  gender        String         @default("UNISEX") // MALE | FEMALE | UNISEX
  family        String         // Oriental, Floral, Woody, etc.
  topNotes      String         // Stored as JSON stringified array or comma-separated
  heartNotes    String         // Stored as JSON stringified array or comma-separated
  baseNotes     String         // Stored as JSON stringified array or comma-separated
  images        String         // Stored as JSON stringified array or comma-separated
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isActive      Boolean        @default(true)
  isFeatured    Boolean        @default(false)
  isBestseller  Boolean        @default(false)
  metaTitle     String?
  metaDesc      String?
  createdAt     DateTime       @default(now())
  variants      Variant[]
  reviews       Review[]
  wishlistItems WishlistItem[]
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String      // 30ml | 50ml | 100ml
  sku        String      @unique
  price      Float
  salePrice  Float?
  stock      Int
  orderItems OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail      String?
  status          String      @default("PENDING") // PENDING | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  items           OrderItem[]
  subtotal        Float
  discountAmount  Float       @default(0)
  shippingCost    Float
  tax             Float
  total           Float
  couponCode      String?
  stripePaymentId String?
  shippingAddress String      // Stored as JSON stringified
  billingAddress  String      // Stored as JSON stringified
  trackingNumber  String?
  notes           String?
  createdAt       DateTime    @default(now())
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  variantSize String
  price       Float
  quantity    Int
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  type          String    // PERCENTAGE | FIXED_AMOUNT | FREE_SHIPPING
  value         Float
  minOrderValue Float?
  maxUses       Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating       Int
  comment      String
  customerName String
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("text") // text | image | richtext
  label     String?
  updatedAt DateTime @updatedAt
}

model ScrollAd {
  id        String   @id @default(cuid())
  text      String
  link      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
