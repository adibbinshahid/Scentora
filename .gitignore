# dependencies (all workspaces)
**/node_modules
/.pnp
.pnp.*

# next.js
**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (all workspaces)
# Broad by design: catches .env, .env.local, and any .env.*-backup copies.
**/.env*
!**/.env.example

# typescript
*.tsbuildinfo

# database files (SQLite — local only, contains user data)
**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal

# uploaded media — tracked so Vercel deployment includes product images
# apps/web/public/uploads/

# payload legacy
/media
src/payload/payload-types.ts
.claude/
.vercel
.env*
