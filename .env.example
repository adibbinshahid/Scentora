# ─── Vercel / Production Environment Variables ───────────────────────────────
# Copy this file, rename to .env (gitignored), and fill in real values.
# In Vercel dashboard: Settings → Environment Variables → add each key below.

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
# Pooled connection — used by the Next.js app at runtime (pgbouncer)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection — used only for prisma db push / migrations
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-[region].pooler.supabase.com:5432/postgres

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Supabase Storage (image uploads) ─────────────────────────────────────────
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── AI Chatbot (Google Gemini) ────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
