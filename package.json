{
  "name": "aurum-noir",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=packages/db/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema=packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "prisma": "^5.10.0"
  }
}
